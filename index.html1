<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Abadir | Web Developer</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<button id="darkToggle">🌙</button>

<header class="fade-in">
  <h1>Abadir</h1>
  <p>Aspiring Web Developer</p>

  <div class="socials">
    <a href="https://github.com/ABADIR460" target="_blank">GitHub</a>
    <a href="https://t.me/yourusername" target="_blank">Telegram</a>
    <a href="cv.pdf" download class="cv-btn">Download CV</a>
  </div>

  <nav>
    <a href="#about">About</a>
    <a href="#skills">Skills</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<section id="about" class="fade-in">
  <h2>About Me</h2>
  <p>
    My name is Abadir from Ethiopia. I am an aspiring web developer
    passionate about building clean and responsive websites.
  </p>
</section>

<section id="skills" class="fade-in">
  <h2>Skills</h2>
  <div class="skills">
    <span>HTML</span>
    <span>CSS</span>
    <span>JavaScript</span>
    <span>GitHub</span>
  </div>
</section>

<section id="projects" class="fade-in">
  <h2>Projects</h2>
  <div class="projects">
    <div class="card">Portfolio Website</div>
    <div class="card">Calculator App</div>
    <div class="card">Quiz App</div>
  </div>
</section>

<section id="contact" class="fade-in">
  <h2>Contact</h2>
  <form id="contactForm">
    <input type="text" placeholder="Your Name" required>
    <input type="email" placeholder="Your Email" required>
    <textarea placeholder="Message" required></textarea>
    <button type="submit">Send</button>
  </form>
  <p id="msg"></p>
</section>

<footer>
  © 2026 Abadir | Ethiopia
</footer>

<script src="script.js"></script>
</body>
</html>